/* RESET & BASE */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background-color: #1a1a1a;
    color: #e0e0e0;
    line-height: 1.6;
}

/* CONTAINER */
.container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
}

/* SECTIONS */
.section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 0;
}

/* HOME SECTION */
#home {
    text-align: center;
}

.name {
    font-size: 3rem;
    font-weight: 700;
    color: #ff6b35;
    margin-bottom: 10px;
}

.title {
    font-size: 1.5rem;
    color: #e0e0e0;
    margin-bottom: 15px;
}

.tagline {
    font-size: 1.1rem;
    color: #b0b0b0;
}

/* HEADINGS */
h2 {
    font-size: 2.5rem;
    color: #ff6b35;
    margin-bottom: 30px;
}

h3 {
    font-size: 1.5rem;
    color: #e0e0e0;
    margin-bottom: 10px;
}

/* TEXT */
p {
    font-size: 1.1rem;
    margin-bottom: 15px;
    color: #c0c0c0;
}

/* SKILLS SECTION */
.skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 20px;
}

.skill-item {
    background-color: #2a2a2a;
    color: #ff6b35;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 500;
    border: 2px solid #ff6b35;
    transition: transform 0.3s;
}

.skill-item:hover {
    transform: scale(1.05);
}

/* PROJECTS SECTION */
.project {
    background-color: #2a2a2a;
    padding: 25px;
    border-radius: 8px;
    margin-bottom: 20px;
    border-left: 4px solid #ff6b35;
    transition: background-color 0.3s;
}

.project:hover {
    background-color: #333333;
}

.coming-soon {
    color: #808080;
    font-style: italic;
    margin-top: 10px;
}

.email a {
    color: #ff6b35;
    text-decoration: none;
    font-weight: 500;
}

.email a:hover {
    text-decoration: underline;
}

footer {
    background-color: #0f0f0f;
    text-align: center;
    padding: 30px 20px;
    color: #808080;
    font-size: 0.95rem;
}

/* MOBILE RESPONSIVE */
@media (max-width: 768px) {
    .name { font-size: 2.2rem; }
    h2 { font-size: 2rem; }
    .section { min-height: auto; padding: 40px 0; }
    .skills-list { flex-direction: column; }
    .skill-item { text-align: center; }
}

@media (max-width: 480px) {
    .name { font-size: 1.8rem; }
    .title { font-size: 1.2rem; }
    h2 { font-size: 1.6rem; }
}